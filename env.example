# Copy to .env and fill in. Never commit .env.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>
# optional: separate Confluent key for Databricks (recommended)
DBX_KAFKA_API_KEY=
DBX_KAFKA_API_SECRET=
